@echo off
rem Regenerate fonts\fonts-manifest.local.js from the font files in fonts\ (Windows).
rem Double-click this file, or run it from a terminal. macOS / Linux: use update-fonts-manifest.sh.
rem Uses the PowerShell built into Windows; the PowerShell code is below the ##POWERSHELL## marker.
setlocal
set "FONTS_SCRIPT=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "iex ((Get-Content -Raw -LiteralPath $env:FONTS_SCRIPT) -split '##POWERSHELL##')[-1]"
pause
exit /b

##POWERSHELL##
# The committed fonts\fonts-manifest.js (fonts shipped with the repo) is only read, never written.
# This script lists every OTHER font file in fonts\ in the git-ignored fonts-manifest.local.js, which
# index.html loads in addition. Keeps the display name and order of fonts already listed, drops entries
# whose file is gone, and appends new files (named after the filename) at the end.
# The first local entry is the font selected when the page loads.
$ErrorActionPreference = 'Stop'
$fontsDir = Join-Path (Split-Path -Parent (Split-Path -Parent $env:FONTS_SCRIPT)) 'fonts'  # scripts\ -> project folder -> fonts
$shippedManifest = Join-Path $fontsDir 'fonts-manifest.js'        # committed, read only
$manifest = Join-Path $fontsDir 'fonts-manifest.local.js'          # generated, git-ignored
$exts = '.otf', '.ttf', '.woff', '.woff2'
$pattern = '\{\s*name:\s*"((?:[^"\\]|\\.)*)"\s*,\s*file:\s*"((?:[^"\\]|\\.)*)"\s*\}'

# fonts named in the committed manifest are loaded from there, so they are skipped here
$shipped = @()
if (Test-Path -LiteralPath $shippedManifest) {
  foreach ($m in [regex]::Matches([IO.File]::ReadAllText($shippedManifest), $pattern)) {
    $shipped += ($m.Groups[2].Value -replace '\\(.)', '$1')
  }
}

$files = @(Get-ChildItem -LiteralPath $fontsDir -File |
  Where-Object { ($exts -contains $_.Extension.ToLower()) -and ($shipped -notcontains $_.Name) } |
  Sort-Object Name | ForEach-Object { $_.Name })

$entries = New-Object System.Collections.ArrayList
if (Test-Path -LiteralPath $manifest) {
  $text = [IO.File]::ReadAllText($manifest)
  foreach ($m in [regex]::Matches($text, $pattern)) {
    $name = $m.Groups[1].Value -replace '\\(.)', '$1'
    $file = $m.Groups[2].Value -replace '\\(.)', '$1'
    if ($files -contains $file) { [void]$entries.Add([pscustomobject]@{ Name = $name; File = $file }) }
  }
}
foreach ($f in $files) {
  if (-not ($entries | Where-Object { $_.File -eq $f })) {
    [void]$entries.Add([pscustomobject]@{ Name = [IO.Path]::GetFileNameWithoutExtension($f); File = $f })
  }
}

function Esc($s) { ($s -replace '\\', '\\') -replace '"', '\"' }

$lines = @(
  '// Generated by update-fonts-manifest.sh / .cmd - rerun it after adding/removing font files.',
  '// Local fonts only (this file is git-ignored). Fonts shipped with the repo are in fonts-manifest.js.',
  '// You can edit display names or reorder lines by hand; the script keeps both.',
  '// The first font listed here is selected when the page loads.'
)
if ($entries.Count -eq 0) {
  $lines += 'window.LOCAL_FONTS_EXTRA = [];'
} else {
  $items = @($entries | ForEach-Object { '  { name: "' + (Esc $_.Name) + '", file: "' + (Esc $_.File) + '" }' })
  $lines += 'window.LOCAL_FONTS_EXTRA = ['
  $lines += ($items -join ",`n")
  $lines += '];'
}
# UTF-8 without BOM and LF line endings, so the output matches the .sh version.
[IO.File]::WriteAllText($manifest, (($lines -join "`n") + "`n"), (New-Object Text.UTF8Encoding $false))

Write-Host "fonts/fonts-manifest.local.js: $($entries.Count) font(s)"
foreach ($e in $entries) { Write-Host "  $($e.Name)  <-  $($e.File)" }
